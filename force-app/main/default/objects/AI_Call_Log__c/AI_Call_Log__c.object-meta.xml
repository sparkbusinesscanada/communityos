<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AI Call Log</label>
    <pluralLabel>AI Call Logs</pluralLabel>
    <description>One row per CommunityOS AI call: what was sent (pseudonymized), what came back, which model and prompt.</description>
    <nameField>
        <displayFormat>AI-{000000}</displayFormat>
        <label>AI Call Number</label>
        <type>AutoNumber</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableHistory>false</enableHistory>
    <enableActivities>false</enableActivities>
</CustomObject>
